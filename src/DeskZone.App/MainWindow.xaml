<Window x:Class="DeskZone.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskZone.App"
        Title="桌序 DeskZone"
        Icon="Assets/DeskZoneLogoCompact.png"
        Width="380"
        Height="650"
        MinWidth="320"
        MinHeight="430"
        WindowStyle="None"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        LocationChanged="Window_LayoutChanged"
        SizeChanged="Window_LayoutChanged">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:AdaptiveCardWidthConverter x:Key="AdaptiveCardWidthConverter" />
        <SolidColorBrush x:Key="ShellSurfaceBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ShellBorderBrush" Color="#40FFFFFF" />
        <SolidColorBrush x:Key="TitlePrimaryBrush" Color="White" />
        <SolidColorBrush x:Key="TitleSecondaryBrush" Color="White" />
        <SolidColorBrush x:Key="ActionBrush" Color="White" />
        <SolidColorBrush x:Key="CategoryMetaBrush" Color="White" />
        <SolidColorBrush x:Key="ContentPrimaryBrush" Color="White" />
        <SolidColorBrush x:Key="CategorySurfaceBrush" Color="#33FCFEFF" />
        <SolidColorBrush x:Key="CategoryHeaderSurfaceBrush" Color="#55FFFFFF" />
        <SolidColorBrush x:Key="CategoryBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="FileItemSurfaceBrush" Color="Transparent" />
        <SolidColorBrush x:Key="FileItemBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="NewCategorySurfaceBrush" Color="#33FCFEFF" />
        <SolidColorBrush x:Key="NewCategoryBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="SettingsDialogSurfaceBrush" Color="White" />
        <SolidColorBrush x:Key="SettingsDialogBorderBrush" Color="#D9E8F5" />
        <SolidColorBrush x:Key="SettingsItemSurfaceBrush" Color="#F7FBFF" />
        <SolidColorBrush x:Key="SettingsItemBorderBrush" Color="#E1ECF6" />
        <SolidColorBrush x:Key="SettingsActionSurfaceBrush" Color="#EEF8FF" />
        <SolidColorBrush x:Key="SettingsActionBorderBrush" Color="#A9D3FA" />
        <SolidColorBrush x:Key="SettingsResetBorderBrush" Color="#C9D9E8" />
        <Thickness x:Key="CategoryBorderThickness">0</Thickness>
        <Thickness x:Key="FileItemBorderThickness">0</Thickness>
        <Thickness x:Key="NewCategoryBorderThickness">0</Thickness>
        <Style x:Key="TitleIconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TitleSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FlatIconButton" TargetType="Button" BasedOn="{StaticResource TitleIconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <!-- Category arrows and the overflow glyph are ordinary text glyphs,
                 not MDL2 icon code points. Keep the title-bar icon font scoped
                 to the title-bar buttons so those glyphs cannot turn into boxes. -->
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="CategoryToggleButton" TargetType="Button" BasedOn="{StaticResource FlatIconButton}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Viewbox Width="10" Height="10" Stretch="Uniform">
                            <Path Data="M 0,0 L 0,10 L 8,5 Z"
                                  Fill="{TemplateBinding Foreground}" />
                        </Viewbox>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpandedForDisplay}" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="90" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CategoryOverflowButton" TargetType="Button" BasedOn="{StaticResource FlatIconButton}">
            <!-- Fill the complete overflow column so the header's drag cursor
                 cannot leak into the clickable menu area. -->
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="2.2" Height="2.2" Margin="1" Fill="{TemplateBinding Foreground}" />
                            <Ellipse Width="2.2" Height="2.2" Margin="1" Fill="{TemplateBinding Foreground}" />
                            <Ellipse Width="2.2" Height="2.2" Margin="1" Fill="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NewCategoryButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResizeHandle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Panel.ZIndex" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsToggle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Background" Value="{DynamicResource SettingsItemSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsItemBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}" />
                                <Border x:Name="Switch"
                                        Grid.Column="1"
                                        Width="36"
                                        Height="20"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="#C9D7E5"
                                        CornerRadius="10">
                                    <Ellipse x:Name="SwitchThumb"
                                             Width="14"
                                             Height="14"
                                             Margin="3"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Fill="White" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Switch" Property="Background" Value="{StaticResource BrandBrush}" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="4"
            CornerRadius="18"
            Background="{DynamicResource ShellSurfaceBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.10" Color="#0B2447" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  x:Name="TitleBar"
                  Background="Transparent"
                  Cursor="SizeAll"
                  PreviewMouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Width="28"
                           Height="28"
                           Margin="0,0,8,0"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="Assets/DeskZoneLogoCompact.png" />
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TitlePrimaryBrush}" Text="桌序" />
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TitleSecondaryBrush}" Margin="6,0,0,0" Text="DeskZone" />
                </StackPanel>

                <Button Grid.Column="0"
                        x:Name="NewCategoryButton"
                        Width="52"
                        Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Style="{StaticResource NewCategoryButtonStyle}"
                        BorderBrush="{DynamicResource NewCategoryBorderBrush}"
                        BorderThickness="{DynamicResource NewCategoryBorderThickness}"
                        Background="{DynamicResource NewCategorySurfaceBrush}"
                        Foreground="{DynamicResource ActionBrush}"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        ToolTip="新建分类；也可以将文件夹拖到这里"
                        AllowDrop="True"
                        DragEnter="NewCategory_DragEnter"
                        DragOver="NewCategory_DragOver"
                        DragLeave="NewCategory_DragLeave"
                        Drop="NewCategory_Drop"
                        Content="＋"
                        Click="NewCategory_Click" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="TransparencyButton"
                                Style="{StaticResource TitleIconButton}"
                                ToolTip="切换为白色显示"
                                Content="◐"
                                FontFamily="Segoe UI Symbol"
                                FontSize="16"
                                Click="Transparency_Click" />
                        <Button x:Name="LockButton"
                                Style="{StaticResource TitleIconButton}"
                                ToolTip="锁定位置"
                                Content="&#xE785;"
                                Click="Lock_Click" />
                    </StackPanel>

                    <Border Width="1" Height="16" Margin="7,0" Background="#E2EBF3" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleIconButton}"
                                ToolTip="设置 / 数据位置"
                                Content="&#xE713;"
                                Click="Settings_Click" />
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource TitleIconButton}"
                                ToolTip="折叠为标题栏"
                                Content="&#xE921;"
                                Click="Minimize_Click" />
                        <Button Style="{StaticResource TitleIconButton}"
                                ToolTip="关闭到通知区域"
                                Content="&#xE8BB;"
                                Click="Close_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" x:Name="WorkspaceBody" Margin="10,4,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Height="36"
                        Margin="0,0,0,8"
                        CornerRadius="10"
                        BorderBrush="{DynamicResource NewCategoryBorderBrush}"
                        BorderThickness="{DynamicResource NewCategoryBorderThickness}"
                        Background="{DynamicResource NewCategorySurfaceBrush}">
                    <Grid>
                        <TextBox x:Name="SearchTextBox"
                                 Padding="10,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource ActionBrush}"
                                 FontSize="11"
                                 VerticalContentAlignment="Center"
                                 ToolTip="搜索客户端中的文件、文件夹和快捷方式"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="SearchTextBox_TextChanged"
                                 KeyDown="SearchTextBox_KeyDown" />
                        <TextBlock x:Name="SearchPlaceholder"
                                   Margin="10,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource CategoryMetaBrush}"
                                   FontSize="11"
                                   Text="搜索文件、文件夹或快捷方式" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              x:Name="CategoryScroll"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled"
                              FocusVisualStyle="{x:Null}"
                              KeyboardNavigation.IsTabStop="False">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}">
                            <!-- Always reserve this slim strip.  With Auto, the bar
                                 appearing at a column boundary changes the card
                                 width, which can immediately remove the bar again
                                 and cause a resize flicker loop. -->
                            <Setter Property="Width" Value="4" />
                            <Setter Property="MinWidth" Value="4" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding Categories}"
                                  HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
                                        Padding="0"
                                        CornerRadius="11"
                                        BorderBrush="{DynamicResource CategoryBorderBrush}"
                                        BorderThickness="{DynamicResource CategoryBorderThickness}"
                                        Background="{DynamicResource CategorySurfaceBrush}"
                                        AllowDrop="True"
                                        Tag="{Binding}"
                                        DragEnter="Category_DragEnter"
                                        DragOver="Category_DragOver"
                                        DragLeave="Category_DragLeave"
                                        Drop="Category_Drop">
                                    <StackPanel>
                                        <Border Background="{DynamicResource CategoryHeaderSurfaceBrush}"
                                                Padding="6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="11,11,0,0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                            <Setter Property="CornerRadius" Value="11" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid Height="36"
                                                  Background="Transparent"
                                                  Tag="{Binding}"
                                                  ToolTip="按住并拖动可调整分类顺序"
                                                  PreviewMouseLeftButtonDown="CategoryHeader_MouseLeftButtonDown"
                                                  PreviewMouseLeftButtonUp="CategoryHeader_MouseLeftButtonUp"
                                                  PreviewMouseMove="CategoryHeader_MouseMove">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Cursor" Value="SizeAll" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                            <Setter Property="Cursor" Value="Arrow" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="30" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    Style="{StaticResource CategoryToggleButton}"
                                                    Foreground="{DynamicResource ActionBrush}"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Tag="{Binding}"
                                                    Click="ToggleCategory_Click" />

                                            <TextBox Grid.Column="1"
                                                     Margin="2,0,6,0"
                                                     Padding="2,0"
                                                     VerticalContentAlignment="Center"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                      Foreground="{DynamicResource ContentPrimaryBrush}"
                                                      FontWeight="SemiBold"
                                                      IsReadOnly="True"
                                                      Cursor="SizeAll"
                                                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="{Binding}"
                                                     ToolTip="双击编辑分类名称"
                                                     PreviewMouseLeftButtonDown="CategoryName_PreviewMouseLeftButtonDown"
                                                     PreviewMouseLeftButtonUp="CategoryName_PreviewMouseLeftButtonUp"
                                                     LostKeyboardFocus="CategoryName_LostKeyboardFocus"
                                                     KeyDown="CategoryName_KeyDown" />

                                            <TextBlock Grid.Column="2"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource CategoryMetaBrush}"
                                                       FontSize="11"
                                                       Text="{Binding VisibleItemCount}" />

                                            <Button Grid.Column="3"
                                                    ToolTip="分类选项"
                                                    Tag="{Binding}"
                                                    Click="CategoryMenu_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource CategoryOverflowButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Button.ContextMenu>
                                                    <ContextMenu Placement="Bottom">
                                                        <MenuItem Header="展开 / 折叠"
                                                                  Click="CategoryMenuToggle_Click" />
                                                        <MenuItem Header="重命名"
                                                                  Click="CategoryMenuRename_Click" />
                                                        <MenuItem Header="复制分类名称"
                                                                  Click="CategoryMenuCopyName_Click" />
                                                        <Separator />
                                                        <MenuItem Header="删除分类"
                                                                  Foreground="#C83D3D"
                                                                  Click="CategoryMenuDelete_Click" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding VisibleItems}"
                                                      Margin="6,0,6,6"
                                                      HorizontalContentAlignment="Stretch"
                                                      Visibility="{Binding IsExpandedForDisplay, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel IsItemsHost="True"
                                                               HorizontalAlignment="Stretch" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border MinWidth="78"
                                                            MinHeight="72"
                                                            Margin="3"
                                                            Padding="5"
                                                            CornerRadius="0"
                                                            Background="{DynamicResource FileItemSurfaceBrush}"
                                                            BorderBrush="{DynamicResource FileItemBorderBrush}"
                                                            BorderThickness="{DynamicResource FileItemBorderThickness}"
                                                             Cursor="Hand"
                                                             ToolTip="{Binding Path}"
                                                             Tag="{Binding}"
                                                             AllowDrop="{Binding CanReorder}"
                                                             MouseLeftButtonDown="FileCard_MouseLeftButtonDown"
                                                             MouseLeftButtonUp="FileCard_MouseLeftButtonUp"
                                                             MouseRightButtonUp="FileCard_MouseRightButtonUp"
                                                             MouseMove="FileCard_MouseMove"
                                                             DragEnter="FileCard_DragEnter"
                                                             DragOver="FileCard_DragOver"
                                                             DragLeave="FileCard_DragLeave"
                                                             Drop="FileCard_Drop">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource AdaptiveCardWidthConverter}">
                                                                <Binding RelativeSource="{RelativeSource AncestorType={x:Type ItemsControl}}"
                                                                         Path="ActualWidth" />
                                                                <Binding RelativeSource="{RelativeSource AncestorType={x:Type ItemsControl}}"
                                                                         Path="DataContext.Items.Count" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                        <StackPanel>
                                                            <Grid Width="32"
                                                                  Height="32"
                                                                  HorizontalAlignment="Center">
                                                                <Image Source="{Binding IconImage}"
                                                                       Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="24"
                                                                           Text="{Binding IconGlyph}" />
                                                            </Grid>
                                                            <TextBlock Margin="2,4,2,0"
                                                                       HorizontalAlignment="Stretch"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxHeight="32"
                                                                       FontSize="10.5"
                                                                       Foreground="{DynamicResource ContentPrimaryBrush}"
                                                                       Text="{Binding Name}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>

            <Thumb x:Name="ResizeTopThumb"
                   Style="{StaticResource ResizeHandle}"
                   Grid.RowSpan="2"
                   Height="7"
                   VerticalAlignment="Top"
                   Cursor="SizeNS"
                   ToolTip="调整窗口高度"
                   DragDelta="ResizeTopThumb_DragDelta" />
            <Thumb x:Name="ResizeBottomThumb"
                   Style="{StaticResource ResizeHandle}"
                   Grid.RowSpan="2"
                   Height="7"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNS"
                   ToolTip="调整窗口高度"
                   DragDelta="ResizeBottomThumb_DragDelta" />
            <Thumb x:Name="ResizeLeftThumb"
                   Style="{StaticResource ResizeHandle}"
                   Grid.RowSpan="2"
                   Width="7"
                   HorizontalAlignment="Left"
                   Cursor="SizeWE"
                   ToolTip="调整窗口宽度"
                   DragDelta="ResizeLeftThumb_DragDelta" />
            <Thumb x:Name="ResizeRightThumb"
                   Style="{StaticResource ResizeHandle}"
                   Grid.RowSpan="2"
                   Width="7"
                   HorizontalAlignment="Right"
                   Cursor="SizeWE"
                   ToolTip="调整窗口宽度"
                   DragDelta="ResizeRightThumb_DragDelta" />
            <Thumb x:Name="ResizeTopLeftThumb"
                   Style="{StaticResource ResizeHandle}"
                   Grid.RowSpan="2"
                   Width="18"
                   Height="18"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Panel.ZIndex="20"
                   Cursor="SizeNWSE"
                   ToolTip="调整窗口大小"
                   DragDelta="ResizeTopLeftThumb_DragDelta" />
            <Thumb x:Name="ResizeTopRightThumb"
                   Style="{StaticResource ResizeHandle}"
                   Grid.RowSpan="2"
                   Width="18"
                   Height="18"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Panel.ZIndex="20"
                   Cursor="SizeNESW"
                   ToolTip="调整窗口大小"
                   DragDelta="ResizeTopRightThumb_DragDelta" />
            <Thumb x:Name="ResizeBottomLeftThumb"
                   Style="{StaticResource ResizeHandle}"
                   Grid.RowSpan="2"
                   Width="18"
                   Height="18"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Panel.ZIndex="20"
                   Cursor="SizeNESW"
                   ToolTip="调整窗口大小"
                   DragDelta="ResizeBottomLeftThumb_DragDelta" />
            <Thumb x:Name="ResizeThumb"
                   Grid.RowSpan="2"
                   Width="22"
                   Height="22"
                   Margin="0,0,2,2"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNWSE"
                   ToolTip="调整窗口大小"
                   DragDelta="ResizeThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="Transparent">
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Border x:Name="SettingsOverlay"
                    Grid.RowSpan="2"
                    Panel.ZIndex="50"
                    Visibility="Collapsed"
                    Background="#5A12314A"
                    Padding="14"
                    SizeChanged="SettingsOverlay_SizeChanged">
                <Border x:Name="SettingsDialog"
                        HorizontalAlignment="Center"
                        Padding="14"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SettingsDialogSurfaceBrush}"
                        BorderBrush="{DynamicResource SettingsDialogBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="设置" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource TitleIconButton}"
                                    ToolTip="关闭设置"
                                    Content="&#xE8BB;"
                                    Click="SettingsClose_Click" />
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,7"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="桌面组件" />
                                <CheckBox x:Name="SettingsLockPositionToggle"
                                          Style="{StaticResource SettingsToggle}"
                                          Click="SettingsLockPosition_Click"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextBrush}"
                                          Content="锁定窗口位置与大小" />
                                <CheckBox x:Name="SettingsStartWithWindowsToggle"
                                          Style="{StaticResource SettingsToggle}"
                                          Click="SettingsStartWithWindows_Click"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextBrush}"
                                          Content="开机自动启动" />
                                <CheckBox x:Name="SettingsCloseToTrayToggle"
                                          Style="{StaticResource SettingsToggle}"
                                          Click="SettingsCloseToTray_Click"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextBrush}"
                                          Content="关闭时保留到通知区域" />

                                <TextBlock Margin="0,8,0,7"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="数据" />
                                <StackPanel Margin="0,0,0,8"
                                            Orientation="Horizontal">
                                    <Button Padding="9,5"
                                            Margin="0,0,8,0"
                                            Background="{DynamicResource SettingsActionSurfaceBrush}"
                                            BorderBrush="{DynamicResource SettingsActionBorderBrush}"
                                            Foreground="{StaticResource BrandBrush}"
                                            Cursor="Hand"
                                            Content="打开文件夹"
                                            Click="SettingsOpenDataFolder_Click" />
                                    <Button Padding="9,5"
                                            Margin="0,0,8,0"
                                            Background="{DynamicResource SettingsActionSurfaceBrush}"
                                            BorderBrush="{DynamicResource SettingsActionBorderBrush}"
                                            Foreground="{StaticResource BrandBrush}"
                                            Cursor="Hand"
                                            Content="导入"
                                            Click="SettingsImportData_Click" />
                                    <Button Padding="9,5"
                                            Background="{DynamicResource SettingsActionSurfaceBrush}"
                                            BorderBrush="{DynamicResource SettingsActionBorderBrush}"
                                            Foreground="{StaticResource BrandBrush}"
                                            Cursor="Hand"
                                            Content="导出"
                                            Click="SettingsExportData_Click" />
                                </StackPanel>
                                <Button Padding="10,7"
                                        HorizontalAlignment="Left"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource SettingsResetBorderBrush}"
                                        Foreground="{StaticResource MutedBrush}"
                                        Cursor="Hand"
                                        Content="恢复窗口大小"
                                        Click="SettingsRestoreSize_Click" />
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="2"
                                Height="32"
                                Margin="0,12,0,0"
                                Background="{StaticResource BrandBrush}"
                                BorderThickness="0"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Content="完成"
                                Click="SettingsClose_Click" />
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
